# Neon
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro

# App URL (local). In Vercel production set:
# NEXT_PUBLIC_SITE_URL=https://www.connectainf.com
# Never use *.vercel.app — invite links and Clerk break on that host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admins (comma-separated). Required for /admin access — not hardcoded in source.
# ADMIN_EMAILS=vos@email.com,otro@email.com

# Vercel Blob (avatars + event images). Created via: vercel blob create-store
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Clerk Dashboard: enable Email + Password under User & authentication
# so registro/login with password works.

# TikTok Login Kit (Connecta account linking — not app login)
# Portal: https://developers.tiktok.com → Login Kit
# Redirect URIs (HTTPS only):
#   https://www.connectainf.com/api/tiktok/callback
#   https://local.connectainf.com/api/tiktok/callback
# Scopes: user.info.basic, user.info.profile, user.info.stats
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://www.connectainf.com/api/tiktok/callback
